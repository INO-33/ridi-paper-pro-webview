+volatile sig_atomic_t g_eink_primary_signal_logging_enabled = 0;
+
+#if defined(__ANDROID__)
+char* AppendEinkSignalText(char* out, char* end, const char* text) {
+  while (out < end && *text)
+    *out++ = *text++;
+  return out;
+}
+
+char* AppendEinkSignalUnsigned(char* out, char* end, unsigned long value) {
+  char digits[20];
+  int count = 0;
+  do {
+    digits[count++] = static_cast<char>('0' + value % 10);
+    value /= 10;
+  } while (value && count < static_cast<int>(sizeof(digits)));
+  while (count && out < end)
+    *out++ = digits[--count];
+  return out;
+}
+
+char* AppendEinkSignalHex(char* out, char* end, uintptr_t value) {
+  static const char kHex[] = "0123456789abcdef";
+  out = AppendEinkSignalText(out, end, "0x");
+  const int digits = sizeof(uintptr_t) * 2;
+  for (int shift = (digits - 1) * 4; shift >= 0 && out < end; shift -= 4)
+    *out++ = kHex[(value >> shift) & 0xf];
+  return out;
+}
+
+void LogEinkPrimarySignal(int sig, siginfo_t* info, void* uc, pid_t tid) {
+  struct ucontext* context = reinterpret_cast<struct ucontext*>(uc);
+  uintptr_t pc = 0;
+  uintptr_t sp = 0;
+#if defined(__i386__)
+  pc = static_cast<uintptr_t>(context->uc_mcontext.gregs[REG_EIP]);
+  sp = static_cast<uintptr_t>(context->uc_mcontext.gregs[REG_ESP]);
+#elif defined(__x86_64__)
+  pc = static_cast<uintptr_t>(context->uc_mcontext.gregs[REG_RIP]);
+  sp = static_cast<uintptr_t>(context->uc_mcontext.gregs[REG_RSP]);
+#elif defined(__arm__)
+  pc = static_cast<uintptr_t>(context->uc_mcontext.arm_pc);
+  sp = static_cast<uintptr_t>(context->uc_mcontext.arm_sp);
+#elif defined(__aarch64__)
+  pc = static_cast<uintptr_t>(context->uc_mcontext.pc);
+  sp = static_cast<uintptr_t>(context->uc_mcontext.sp);
+#endif
+
+  char line[256];
+  char* out = line;
+  char* const end = line + sizeof(line) - 1;
+  out = AppendEinkSignalText(out, end, "EINK_T1_PRIMARY signo=");
+  out = AppendEinkSignalUnsigned(out, end, sig);
+  out = AppendEinkSignalText(out, end, " code=");
+  out = AppendEinkSignalUnsigned(out, end, info->si_code);
+  out = AppendEinkSignalText(out, end, " addr=");
+  out = AppendEinkSignalHex(out, end,
+                            reinterpret_cast<uintptr_t>(info->si_addr));
+  out = AppendEinkSignalText(out, end, " tid=");
+  out = AppendEinkSignalUnsigned(out, end, tid);
+  out = AppendEinkSignalText(out, end, " pc=");
+  out = AppendEinkSignalHex(out, end, pc);
+  out = AppendEinkSignalText(out, end, " sp=");
+  out = AppendEinkSignalHex(out, end, sp);
+  *out = '\0';
+  logger::writeToCrashLog(line);
+}
+#endif  // defined(__ANDROID__)
+
 }  // namespace
 
+void SetEinkPrimarySignalLoggingEnabled(bool enabled) {
+  g_eink_primary_signal_logging_enabled = enabled ? 1 : 0;
+}
